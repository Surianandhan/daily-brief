# Copy to .env for local development. Set the same values in Vercel for production.
# Never commit real values.

# Google OAuth client (Google Cloud Console → Google Auth Platform → Clients → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32+ random characters, used to encrypt the session cookie: openssl rand -base64 32
AUTH_SECRET=

# Gemini API key (aistudio.google.com). Use a paid-tier key in production.
GEMINI_API_KEY=

# Contact address shown on the Privacy Policy and Terms pages
CONTACT_EMAIL=
