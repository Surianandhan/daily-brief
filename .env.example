# Copy to .env for local development. Set the same values in Vercel for production.
# Never commit real values.

# Required: Google OAuth client (Google Cloud Console → Google Auth Platform → Clients → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommended: free Gemini API key from aistudio.google.com (without it, the rule-based engine is used)
GEMINI_API_KEY=

# Optional: session-cookie encryption key (32+ random chars). Derived from GOOGLE_CLIENT_SECRET if unset.
AUTH_SECRET=

# Optional: contact address on the Privacy/Terms pages (falls back to the GitHub issues link)
CONTACT_EMAIL=
